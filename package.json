{
  "name": "stacks-flash-loans",
  "version": "1.0.0",
  "description": "A secure flash loan implementation for the Stacks blockchain, enabling uncollateralized borrowing within a single transaction with automatic repayment verification",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "vitest run",
    "test:report": "vitest run -- --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\""
  },
  "author": "AdekunleBamz",
  "license": "ISC",
  "dependencies": {
    "@hirosystems/clarinet-sdk": "^3.0.2",
    "@stacks/transactions": "^7.0.6",
    "chokidar-cli": "^3.0.0",
    "vitest": "^3.1.3",
    "vitest-environment-clarinet": "^2.3.0"
  },
  "devDependencies": {
    "@hirosystems/clarinet-sdk-wasm": "^3.7.0",
    "vite": "^7.1.9"
  },
  "repository": "https://github.com/AdekunleBamz/stacks-flash-loan",
  "homepage": "https://github.com/AdekunleBamz/stacks-flash-loan#readme",
  "bugs": "https://github.com/AdekunleBamz/stacks-flash-loan/issues",
  "keywords": "clarity,smart-contract,blockchain,defi,flash-loans,stacks,sip-010,arbitrage,liquidation,uncollateralized"
}
